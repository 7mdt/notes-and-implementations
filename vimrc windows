function! CompileAndRunCpp()
    let l:filename = expand('%:t:r')
    let l:filepath = expand('%:p')
    let l:output = 'main.exe'

    let l:compile_cmd = printf('g++ -std=c++20 -O2 -Wall "%s" -o "%s"', l:filepath, l:output)
    let l:status = system(l:compile_cmd)

    if v:shell_error != 0
        echo '❌ Compilation failed.'
        return
    endif

    let l:width = float2nr(&columns * 0.8)
    let l:height = float2nr(&lines * 0.8)
    let l:row = float2nr((&lines - l:height) / 2)
    let l:col = float2nr((&columns - l:width) / 2)

    let l:buf = nvim_create_buf(v:false, v:true)
    call nvim_open_win(l:buf, v:true, {
        \ 'relative': 'editor',
        \ 'row': l:row,
        \ 'col': l:col,
        \ 'width': l:width,
        \ 'height': l:height,
        \ 'style': 'minimal',
        \ 'border': 'rounded'
        \ })

    call termopen(printf('cmd.exe /C "%s & echo. & echo [Press any key to close] & pause"', l:output), {
        \ 'on_exit': {-> execute('bd! ' . l:buf)}
        \ })

    startinsert
endfunction

nnoremap <silent> <F1> :call CompileAndRunCpp()<CR>
